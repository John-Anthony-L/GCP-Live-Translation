# ==============================================================================
# Google Cloud Live Translation POC - Environment Configuration
# ==============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update PROJECT_ID to your own GCP Project ID:
#    gcloud config set project <YOUR_PROJECT_ID>
#
# 3. Authenticate Application Default Credentials (ADC):
#    gcloud auth application-default login
# ==============================================================================

# Your Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# GCP Region for Cloud Run, Translation API v3, DLP, and Cloud TTS
LOCATION=us-central1

# Multi-region endpoint for Speech-to-Text v2 Chirp 3 (must be 'us' or 'eu')
CHIRP_REGION=us

# Live translation engines
# The engine is selected per session in the UI (Translation Engine dropdown):
#   - chirp_3                    Chirp 3 (Speech-to-Text V2 streaming) -> Cloud DLP -> Translation v3 -> Chirp 3 HD TTS
#   - gemini-3.5-transcribe      Gemini 3.5 Transcribe (Live API) -> Cloud DLP -> Translation v3 -> Chirp 3 HD TTS
#   - gemini-3.5-live-translate  Gemini 3.5 Live Translate, speech-to-speech (push-to-talk only)
#   - gemini-3.8-live            Gemini 3.8 Live, speech-to-speech interpreter
# Optional overrides for the Gemini model IDs and endpoints (Gemini Enterprise Agent Platform):
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live-preview
GEMINI_TRANSCRIBE_LOCATION=global
GEMINI_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
GEMINI_LIVE_TRANSLATE_LOCATION=global
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_LOCATION=us-central1

# Text-to-Speech: Chirp 3 HD voices are chosen per session from the UI "Voice Personality"
# setting and the target language (e.g. es-US-Chirp3-HD-Aoede, en-US-Chirp3-HD-Aoede).

# Cloud Translation API Advanced Glossary Configuration
GLOSSARY_ID=brand-parks-glossary-en-es
GLOSSARY_BUCKET=your-gcp-project-id-glossaries

# Local Development Ports
PORT_PIPELINE=8081
PORT_WEB=3000
