# ==============================================================================
# Google Cloud Live Translation POC - Environment Configuration
# ==============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update PROJECT_ID to your own GCP Project ID:
#    gcloud config set project <YOUR_PROJECT_ID>
#
# 3. Authenticate Application Default Credentials (ADC):
#    gcloud auth application-default login
# ==============================================================================

# Your Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# GCP Region for Cloud Run, Translation API v3, DLP, and Cloud TTS
LOCATION=us-central1

# Multi-region endpoint for Speech-to-Text v2 Chirp 3 (must be 'us' or 'eu')
CHIRP_REGION=us

# Speech-to-Text Model Selection
# Options:
#   - chirp_3: Google Cloud Speech v2 GA with Enterprise Brand Phrase Sets (Default / Recommended)
#   - gemini-3.5-transcribe: Gemini 3.5 Live Transcribe (Google GenAI Live SDK)
#   - latest_short: Cloud Speech v1 model optimized for short push-to-talk queries (< 10s)
STT_MODEL=chirp_3

# Text-to-Speech Voice Configuration
# Options: Chirp 3 HD voices (e.g. es-US-Chirp3-HD-Aoede, en-US-Chirp3-HD-Aoede)
TTS_VOICE_NAME=es-US-Chirp3-HD-Aoede

# Cloud Translation API Advanced Glossary Configuration
GLOSSARY_ID=brand-parks-glossary-en-es
GLOSSARY_BUCKET=your-gcp-project-id-glossaries

# Local Development Ports
PORT_PIPELINE=8081
PORT_WEB=3000
